node_modules/
/dist
промо/захват/клипы/
промо/захват/server.log

# Пакеты для площадок: релизы/happy-math-web-v2.zip (itch, ~750 КБ) и
# релизы/android/*.aab|apk (~9 МБ каждый). Пересобираются КАЖДЫМ билдом —
# в истории это горы несжимаемых бинарей, а воспроизводятся одной командой
# (scripts/build-itch.sh, scripts/build-android.sh).
/релизы
scripts/itch-check/скрины/

# Ключи подписи Android — НИКОГДА в git (реальные лежат в ~/keys/happymath/)
*.jks
*.keystore
keystore.properties

# Слои промо-голограммы: 780 PNG с альфой 1080x1920 + mp4 + wav (~500 МБ).
# Пересобираются одной командой (scripts/capture-layers.mjs), в git идут только
# README со списком кадров-событий, дев-хуки движка и сам скрипт.
промо/слои/*/
!промо/слои/audio/
промо/слои/audio/*
!промо/слои/audio/LICENSE-NOTE.txt

# Скрины сторов v2: 20 PNG 1080x1920 + фиче-графика (~27 МБ). Пересобираются одной
# командой (scripts/capture-store-shots.mjs), в git идёт README и сам скрипт.
промо/скрины-сторов-v2/clean/
промо/скрины-сторов-v2/captioned/
промо/скрины-сторов-v2/*.png
